# ------------------------------------------------------------------
# Contact form. Defaults to a console logger so the site runs with no secrets.
# ------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# CONTACT_INBOX=info@kaizenlaw.ca
# CONTACT_SENDER=website@kaizenlaw.ca

# ------------------------------------------------------------------
# Admin panel + auth (required to sign in at /admin).
# ------------------------------------------------------------------
# Signs the session cookie AND encrypts the credential overlay. >= 16 chars.
#   openssl rand -base64 32
# AUTH_SECRET=

# Bootstrap owner login. OWNER_PASSWORD_HASH is a scrypt "saltHex:hashHex".
# Generate the hash (replace YOURPASSWORD):
#   node -e "const c=require('crypto');const s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync('YOURPASSWORD',s,64).toString('hex'))"
# OWNER_USERNAME=admin
# OWNER_PASSWORD_HASH=

# Bearer token for the scheduled blog generator (must match the GitHub Action secret).
# CRON_SECRET=

# ------------------------------------------------------------------
# Content store ("Git is the database"). Unset → local filesystem (dev only).
# In production (read-only FS) these are REQUIRED to persist drafts + credentials.
# ------------------------------------------------------------------
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_BRANCH=main

# ------------------------------------------------------------------
# AI blog generation (OpenAI). Unset → the "Generate draft" button errors gracefully.
# ------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------
# Public reviews (Google Places API "New"). Unset → static fallback (empty).
# Also set googleBusiness.placeId in src/lib/site.config.ts.
# ------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------
# Admin reviews management (Central Review Management API). Optional.
# Server-only — never prefix with NEXT_PUBLIC_. Also flip
# adminFeatures.reviewReplies to true in site.config.ts to enable AI replies.
# ------------------------------------------------------------------
# REVIEW_API_URL=
# REVIEW_API_KEY=
